# Cal.com API credentials — copy to .env.local and fill in real values.
# .env.local is gitignored; this file is committed as a template.

# Personal API key from cal.com → Settings → Developer → API Keys
CAL_API_KEY="cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Numeric event type id for the appointment (cal.com → Event Types → ... → ID)
CAL_EVENT_TYPE_ID="0000000"

# Clinic timezone (IANA). All times are normalized to / displayed in this zone.
CAL_TIMEZONE="America/New_York"

# Cal.com v2 API base URL (production default).
CAL_API_URL="https://api.cal.com/v2"
